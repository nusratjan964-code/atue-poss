# ==============================================================================
# Drive2Social AI — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

PORT=3000
NODE_ENV=development

# 32-character encryption secret for encrypting OAuth tokens at rest
APP_SECRET=drive2social-secure-encryption-key-32chars!!

# ------------------------------------------------------------------------------
# Google Cloud Platform (Google Drive API + YouTube Data API v3)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ------------------------------------------------------------------------------
# Google Gemini Multimodal AI API
# Get your API key from Google AI Studio: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Scheduler & Timezone Settings
# Default timezone: Asia/Dhaka (daily limit resets at midnight Dhaka time)
# ------------------------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Dhaka
DAILY_VIDEO_LIMIT=3

# ------------------------------------------------------------------------------
# Social Media Platform Toggles
# ------------------------------------------------------------------------------
YOUTUBE_ENABLED=true
FACEBOOK_ENABLED=true
INSTAGRAM_ENABLED=true
TIKTOK_ENABLED=true
